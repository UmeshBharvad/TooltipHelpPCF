<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Contoso" constructor="FluentUIControl" version="0.0.1" display-name-key="FluentUIControl" description-key="FluentUIControl description" control-type="virtual" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="value" display-name-key="Value" description-key="Text value for the control" of-type="SingleLine.Text" usage="bound" required="true" />
    <property name="tooltipContent" display-name-key="Tooltip Content" description-key="Content to display in the tooltip" of-type="SingleLine.Text" usage="bound" required="true" />
    <property name="useEnvironmentVariable" display-name-key="Use Environment Variable" description-key="Whether to read the description from an environment variable" of-type="Enum" usage="input" required="true">
      <value name="true" display-name-key="Yes">true</value>
      <value name="false" display-name-key="No">false</value>
    </property>
    <property name="environmentVariableName" display-name-key="Environment Variable Name" description-key="The name of the environment variable to use" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="iconPosition" display-name-key="Icon Position" description-key="Position of the help icon relative to the control" of-type="Enum" usage="input" required="true">
      <value name="left" display-name-key="Left">left</value>
      <value name="right" display-name-key="Right">right</value>
    </property>
    <property name="tooltipStyle" display-name-key="Tooltip Style" description-key="Style of the tooltip content" of-type="Enum" usage="input" required="true">
      <value name="plainText" display-name-key="Plain Text">plainText</value>
      <value name="html" display-name-key="HTML">html</value>
    </property>
    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.8.6" />
      <platform-library name="Fluent" version="8.29.0" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/FluentUIControl.css" order="1" />
      <resx path="strings/FluentUIControl.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
